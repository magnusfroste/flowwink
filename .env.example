# =============================================================================
# FLOWWINK ENVIRONMENT VARIABLES
# =============================================================================
# cp .env.example .env
#
# Generated from the code, not from memory: every name below is read somewhere in
# src/ or supabase/functions/, and the function that reads it is named. Regenerate
# the inventory with:
#
#   grep -rhoE "Deno\.env\.get\(['\"][A-Z_0-9]+" supabase/functions/ | sort -u
#   grep -rhoE "import\.meta\.env\.[A-Z_]+" src/ | sort -u
# =============================================================================


# =============================================================================
# 1. FRONTEND (.env — required)
# =============================================================================
# These three are the whole frontend surface; nothing else in src/ reads the
# environment. Vite INLINES them at build time, so they must exist before the
# build runs. Changing one in Vercel and redeploying the same artifact does
# nothing — you need a new build. That is the usual "I changed the ref and it
# still points at the old project" surprise.

VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_REF"

# The publishable key is public by design — it ships inside the bundle. RLS is
# what protects the data, not the key. Never put a service-role key here.


# =============================================================================
# 2. EDGE FUNCTION SECRETS (NOT .env)
# =============================================================================
# Set with:  supabase secrets set NAME=value --project-ref <ref>
# Or:        Dashboard → Project Settings → Edge Functions → Secrets
#
# Supabase provides these automatically — do not set them:
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
#
# /admin/integrations shows which of the below are present on a live instance
# (check-secrets reports it), so you can verify rather than assume.


# -----------------------------------------------------------------------------
# 2a. Needed for a working install
# -----------------------------------------------------------------------------

# At least ONE AI provider, or every agent feature is inert: FlowPilot, chat,
# text generation, enrichment, migration.
#   _shared/ai-providers, agent-execute, chat-completion, and ~20 more
# OPENAI_API_KEY=""       # https://platform.openai.com/api-keys
# GEMINI_API_KEY=""       # https://aistudio.google.com/apikey  (often cheaper)
# ANTHROPIC_API_KEY=""    # https://console.anthropic.com

# Outbound email. Without it there are no order confirmations, invoices,
# newsletters or booking mails — the system runs and quietly sends nothing.
# Resend is the default transactional transport; SMTP below is the self-hosted
# alternative and Composio the company mailbox.
#   email-send, agent-execute, newsletter-send, send-invoice-email
# RESEND_API_KEY=""       # https://resend.com/api-keys

# Absolute links in emails, PDFs and Stripe return URLs. Unset, several
# functions build links against an empty string and the mail goes out with
# broken hrefs — no error anywhere.
#   agent-execute, create-checkout, document-sign-request, flowpilot-lifecycle,
#   quote-expiry-reminders, newsletter/gdpr
# PUBLIC_SITE_URL="https://your-site.example"
#
# NOTE: gmail-oauth-callback also accepts the older name SITE_URL for backward
# compatibility. Set PUBLIC_SITE_URL — it is the one every other function reads.


# -----------------------------------------------------------------------------
# 2b. Commerce
# -----------------------------------------------------------------------------
# Checkout, invoice payment links, subscriptions.
#   create-checkout, create-invoice-payment, stripe-webhook, _shared/stripe
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""   # from the Stripe dashboard webhook you create


# -----------------------------------------------------------------------------
# 2c. Email transports beyond Resend (optional)
# -----------------------------------------------------------------------------
# SMTP — self-host friendly, no vendor account. Host/port/user/TLS are editable
# in the SMTP integration card; only the password belongs here. The integration
# must also be switched on: the sender requires enabled === true, not merely a
# key being present.
#   email-send
# SMTP_PASS=""
# SMTP_HOST=""        # optional here — the admin card can supply it
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_SECURE="false" # true only for port 465 (implicit TLS)
# SMTP_FROM=""

# Composio — the company Gmail mailbox: conversational mail out AND replies back.
#   composio-proxy, composio-webhook, email-send, agent-execute
# COMPOSIO_API_KEY=""
# COMPOSIO_WEBHOOK_SECRET=""   # signs inbound pushes; unset = signature check skipped

# Peppol e-invoicing — the access point that carries UBL documents (einvoice).
#   The URL and name live in site_settings.einvoice (Invoices → E-invoice); only the
#   bearer token is a secret. Unset = sends are recorded as simulated, never as sent.
# PEPPOL_AP_TOKEN=""

# Gmail via direct OAuth (an older path than Composio).
#   gmail-oauth-callback, _shared
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""


# -----------------------------------------------------------------------------
# 2d. Web intelligence (optional)
# -----------------------------------------------------------------------------
# Scraping and search for enrichment, site migration and research.
#   migrate-page, web-scrape, web-search, prospect-research
# FIRECRAWL_API_KEY=""     # https://firecrawl.dev
# JINA_API_KEY=""          # reader/search fallback
# HUNTER_API_KEY=""        # contact discovery
# UNSPLASH_ACCESS_KEY=""   # stock imagery for generated pages
# GOOGLE_API_KEY=""        # extract-pdf-text only


# -----------------------------------------------------------------------------
# 2e. Contact centre channels (optional, one per channel)
# -----------------------------------------------------------------------------
# Telegram
#   telegram-ingest
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_WEBHOOK_SECRET=""

# Voice and SMS
#   elks46-ingest, voice-recording
# ELKS46_API_USERNAME=""
# ELKS46_API_PASSWORD=""
#   twilio-ingest
# TWILIO_API_KEY=""
# TWILIO_FROM_NUMBER=""
#   gatewayapi-ingest
# GATEWAYAPI_API_KEY=""

# Speech
#   chat-stt, voice-ingest
# ELEVENLABS_API_KEY=""
# LOCAL_AI_API_KEY=""             # self-hosted STT endpoint
# GEMINI_LIVE_MODEL_NATIVE=""     # override the default live model
# GEMINI_LIVE_MODEL_CASCADE=""


# -----------------------------------------------------------------------------
# 2f. Self-hosted and misc (optional)
# -----------------------------------------------------------------------------
# Local LLM — endpoint and model are set in Admin → Chat Settings; only an API
# key, if your endpoint needs one, belongs here.
#   _shared/ai-providers
# LOCAL_LLM_API_KEY=""

# n8n automation webhooks.
#   _shared
# N8N_API_KEY=""

# Lovable's AI gateway. Used by a few functions as a fallback provider; a
# self-hosted install that wants no dependency on it should make sure one of the
# providers in 2a is set instead.
#   docs-chat, gatewayapi-ingest, twilio-ingest
# LOVABLE_API_KEY=""
