#!/bin/sh
# Run the BLOCKING gates before a push, the same ones CI blocks on: the app
# tsconfig (not the lighter one) and the correctness lint gate. Twice this
# week a PR reached CI red — once on rules-of-hooks, once on a hook placed
# after an early return — because the local run used a lighter check and the
# merge script merged on a stale green. Machines don't forget the strict one.
#
# Missing tooling → warn and let the push through (CI still blocks).
# A gate FAILING with tooling present → block. A guard converted to a silent
# pass is how it stops guarding.
if ! command -v npx >/dev/null 2>&1; then
  echo "[pre-push] npx not found — skipping local gates (CI will run them)"
  exit 0
fi
# The app config is a 3 500-file program: ~2.6 GB and ~150 s cold, which
# aborted Node's default heap on a laptop the day v4.0.0 was tagged
# (2026-10-28). Incremental, with the build info outside the tree, makes every
# later run ~10 s and under 1 GB; the heap floor covers the cold run. CI keeps
# the plain command — a fresh runner has nothing to be incremental against.
#
# Heap floor: 8192 MB. Measured cold on Node 22 (Linux): 2048 aborts, 3072
# passes at ~2.4 GB RSS, 4096 at ~2.5 GB, 6144 at ~2.7 GB. Two Mac sessions on
# Node 26 (2026-10-28) hit a heap OOM under the old 6144 floor and passed with
# 8192, so the floor sits there; it is a ceiling, not an allocation. A
# NODE_OPTIONS the user already exports wins only when its own
# --max-old-space-size is at least the floor; any other value (none set, or a
# smaller one, e.g. from an agent harness) gets the floor appended — the last
# flag wins in Node — so it can no longer bypass the floor.
HEAP_FLOOR_MB=8192
user_heap_mb=$(printf '%s' "${NODE_OPTIONS:-}" | sed -n 's/.*--max-old-space-size[= ]\([0-9][0-9]*\).*/\1/p')
if [ -z "$user_heap_mb" ] || [ "$user_heap_mb" -lt "$HEAP_FLOOR_MB" ]; then
  NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--max-old-space-size=$HEAP_FLOOR_MB"
  export NODE_OPTIONS
fi
mkdir -p node_modules/.cache/tsc
echo "[pre-push] tsc (app config, incremental)…"
if ! npx tsc -p tsconfig.app.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/app.tsbuildinfo; then
  echo "[pre-push] tsc FAILED — push blocked."
  exit 1
fi
if command -v bun >/dev/null 2>&1; then
  echo "[pre-push] correctness lint gate…"
  if ! bun run scripts/lint-correctness-gate.ts; then
    echo "[pre-push] correctness gate FAILED (output above) — push blocked."
    exit 1
  fi
else
  echo "[pre-push] bun not installed — skipping correctness gate (CI will run it)"
fi
