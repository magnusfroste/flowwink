#!/bin/sh
# Generated artifacts never ride a commit. The eight files in
# scripts/generated-artifacts.ts are pure functions of the source; CI rebuilds
# them before tests and build, and refresh-generated-artifacts.yml commits them
# on main after every merge. A PR that carried them conflicted with every other
# PR (the manifest: 96 commits in 30 days). Until 2026-10-02 this hook did the
# opposite — regenerated and staged the manifest — which is exactly how they
# ended up in every PR.
#
# If you need them fresh locally (npm run dev imports the manifest, functions
# serve imports the skills JSON): npm run artifacts:build — the result stays in
# the working tree; this hook keeps it out of the commit.
if command -v bun >/dev/null 2>&1; then
  PATHS=$(bun run scripts/generated-artifacts.ts --list 2>/dev/null)
else
  PATHS="supabase/seed/module-skills.json supabase/seed/module-automations.json supabase/seed/locale-packs.json supabase/functions/agent-execute/_module-skills.json supabase/functions/agent-execute/_locale-packs.json supabase/functions/agent-execute/_ui-text-catalog.json supabase/functions/_shared/skills/skill-modules.ts supabase/seed/instance-manifest.json"
fi
STAGED=$(git diff --cached --name-only -- $PATHS)
if [ -n "$STAGED" ]; then
  echo "[pre-commit] generated artifacts were staged — unstaging them (CI rebuilds, main gets them from refresh-generated-artifacts.yml):"
  echo "$STAGED" | sed 's/^/             /'
  git restore --staged -- $STAGED
  if git diff --cached --quiet; then
    echo "[pre-commit] nothing else to commit."; exit 1
  fi
fi
